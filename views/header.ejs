<header class="header">
  <h1 class="app-title"><%= appTitle %></h1>
  <nav class="navbar">
    <% if (!user) { %>
    <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
    <a href="/users/signup" class="<%= currentPath === '/users/signup' ? 'active' : '' %>"
      >Sign Up</a
    >
    <a href="/auth/login" class="<%= currentPath === '/auth/login' ? 'active' : '' %>"
      >Log In</a
    >
    <% } else { %>
    <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
    <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>"
      >Dashboard</a
    >
    <form action="/auth/logout" method="post">
      <button type="submit" class="<%= currentPath === '/auth/logout' ? 'active' : '' %>">
        Log Out
      </button>
    </form>
    <% } %>
  </nav>
</header>
